{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://taskify-zm5u.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://taskify-zm5u.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
